# {{ ansible_managed }}
network:
  version: 2
  ethernets:
    enp1s0:
      dhcp4: true
      optional: true
      wakeonlan: true
      dhcp4-overrides:
        route-metric: 100
    {{ lan_nic }}:
      dhcp4: true
      optional: true
      wakeonlan: true
      dhcp4-overrides:
        route-metric: 110
